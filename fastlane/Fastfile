default_platform(:ios)
PAKET = "com.kamilsaim.izlence"
TAKIM = "NBTXFU47EV"
platform :ios do
  desc "İmzalı arşivi TestFlight'a yükle; App Store yayını yapma"
  lane :testflight_yukle do
    setup_ci
    app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"), is_key_content_base64: true)
    import_certificate(certificate_path: "dagitim.p12", certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain", keychain_password: "")
    get_provisioning_profile(app_identifier: PAKET, force: true)
    profil = lane_context[SharedValues::SIGH_NAME]
    update_code_signing_settings(path: "Izlence.xcodeproj", targets: ["Izlence"], build_configurations: ["Release"],
      use_automatic_signing: false, team_id: TAKIM, code_sign_identity: "Apple Distribution", profile_name: profil)
    build_app(project: "Izlence.xcodeproj", scheme: "Izlence", configuration: "Release", export_method: "app-store",
      export_options: { provisioningProfiles: { PAKET => profil } }, output_directory: "build", output_name: "Izlence.ipa", clean: true)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
